{
    "name": "warrior/rest-processor",
    "description": "Lightweight, fluent, and powerful REST query processor for Laravel Eloquent.",
    "keywords": ["laravel", "eloquent", "rest", "api", "filter", "query-builder", "clean-code"],
    "license": "MIT",
    "authors": [
        {
            "name": "Warrior",
            "email": "dev@warrior.test"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/pipeline": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Warrior\\RestProcessor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Warrior\\RestProcessor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Warrior\\RestProcessor\\RestProcessorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
